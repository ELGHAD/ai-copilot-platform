### IDE ###
.idea/
.vscode/
*.iml

### Backend - Spring Boot / Maven ###
backend/**/target/
backend/**/*.class
# NOTE: do not ignore .mvn/ — mvnw needs .mvn/wrapper/maven-wrapper.properties
# to resolve the Maven distribution. Ignoring it makes every ./mvnw call fail.
backend/**/.mvn/wrapper/*.jar
backend/**/uploads/*
!backend/**/uploads/.gitkeep

### Frontend - Angular ###
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/*.log

### RAG service - Python ###
rag-service/venv/
rag-service/.venv/
rag-service/__pycache__/
rag-service/**/*.pyc
rag-service/.env

### Secrets globaux ###
**/.env
!**/.env.example

### OS ###
.DS_Store
Thumbs.db
.dev/
