# ─────────────────────────────────────────────────────────────────────────────
# ALTEN AI Copilot — single source of truth for local configuration.
#
#   cp .env.example .env      then fill in OPENAI_API_KEY
#
# ./dev.sh loads this file and exports it to every process it starts, so all
# five Spring services and the rag-service read the same values. Docker Compose
# also picks it up automatically for the database containers.
#
# .env is gitignored. .env.example is committed — never put a real secret here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Databases ────────────────────────────────────────────────────────────────
# Consumed by compose.yml (container init) AND by the Spring services (JDBC).
# Changing POSTGRES_PASSWORD after the volumes exist will NOT change the
# password already baked into them — `docker compose down -v` first.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally

APP_DB_NAME=alten_copilot
APP_DB_PORT=5433

VECTOR_DB_NAME=rag_db
VECTOR_DB_PORT=5435

# ── JWT ──────────────────────────────────────────────────────────────────────
# MUST be identical across all five services — they all validate the same
# tokens. Base64, at least 32 bytes decoded (HS256). Regenerate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── OpenAI / endpoint compatible ─────────────────────────────────────────────
# Required. rag-service refuses to start without it unless USE_LOCAL_FALLBACK=true.
OPENAI_API_KEY=

# Leave EMPTY to use api.openai.com.
#
# Set it to talk to any OpenAI-compatible endpoint instead - LiteLLM, OpenRouter,
# vLLM, Ollama, a corporate gateway. Include the path suffix the gateway expects,
# which is almost always /v1:
#   OPENAI_BASE_URL=https://my-gateway.example.com/v1
#
# NOTE: Azure OpenAI is NOT plain-compatible - it needs a different client class
# (AzureChatOpenAI, api-version, deployment names). base_url alone will not work.
OPENAI_BASE_URL=

# Optional per-client overrides. Many gateways serve chat but not embeddings,
# so you can split them. Empty = fall back to OPENAI_BASE_URL.
EMBEDDING_BASE_URL=
LLM_BASE_URL=

# langchain pre-tokenises text and POSTs integer arrays to /embeddings. OpenAI
# accepts that; most compatible gateways reject it and want raw strings.
# Unset = automatic (disabled whenever a custom base URL is configured).
# Force with true/false only if the automatic choice is wrong for your gateway.
# EMBEDDING_CHECK_CTX_LENGTH=

EMBEDDING_MODEL=text-embedding-3-small
# Must be a model your endpoint actually serves. A custom gateway will NOT
# necessarily have the OpenAI defaults — check /v1/models before assuming.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ── RAG tuning ───────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RETRIEVED_DOCS=6

RAG_SERVICE_HOST=0.0.0.0
RAG_SERVICE_PORT=8085

# Set true to let rag-service boot and serve /health without an OpenAI key.
# Chat requests will still fail — this is for working on non-AI parts only.
USE_LOCAL_FALLBACK=false
